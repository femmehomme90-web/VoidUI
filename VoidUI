        Tab:AddMultiToggle({ Label = "Modes", Options = {"Fast","Safe","Stealth"}, Callback = function(selected) end })
        
        VoidUI:Notify({ Title = "Done!", Message = "Script loaded.", Duration = 3 })
]]

