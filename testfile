--========================================================
-- AUTO ARENA
-- Modules du jeu : PlayerScripts.UI.2d.Arena.ArenaClient / ArenaState
-- et PlayerScripts.UI.2d.Settings.ArenaRankSettings (required en
-- lecture seule, jamais monkey-patchés — mêmes fonctions que celles
-- utilisées par les boutons Battle / Claim / Equip Best du jeu).
--========================================================

local AutoArenaController = (function()

local autoArenaFightEnabled = false
local autoArenaEquipBestEnabled = false
local autoArenaClaimEnabled = false

-- Marge de sécurité entre la fin confirmée d'un combat et le prochain
-- ArenaFight. Trop court (ou absent) et les combats peuvent s'enchaîner
-- avant que le jeu ait fini de sortir le joueur de la zone Arena ->
-- il finit coincé dedans, sans retour possible vers la zone normale.
local autoArenaPostBattleDelay = 3

local autoArenaFightWorkerToken = 0
local autoArenaEquipBestWorkerToken = 0
local autoArenaClaimWorkerToken = 0

local AUTO_ARENA_POLL_DELAY = 0.5
local AUTO_ARENA_REMOTE_TIMEOUT = 8
local AUTO_ARENA_BATTLE_START_TIMEOUT = 6
local AUTO_ARENA_BATTLE_TIMEOUT = 30
local AUTO_ARENA_EQUIP_DELAY = 5
local AUTO_ARENA_CLAIM_DELAY = 3
local ARENA_VIEW_REFRESH_COOLDOWN = 2

local function invalidateAutoArenaFightWorker()
	autoArenaFightWorkerToken = autoArenaFightWorkerToken + 1
end

local function invalidateAutoArenaEquipBestWorker()
	autoArenaEquipBestWorkerToken = autoArenaEquipBestWorkerToken + 1
end

local function invalidateAutoArenaClaimWorker()
	autoArenaClaimWorkerToken = autoArenaClaimWorkerToken + 1
end

local function safeRequireArena(moduleScript)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end

	local ok, result = pcall(require, moduleScript)
	if not ok then
		return nil
	end

	return result
end

-- Caché uniquement en cas de succès : tant que le dossier Arena du
-- jeu n'est pas encore chargé (ex. exécuté trop tôt), on retente à
-- chaque appel plutôt que de figer un échec définitif.
local arenaSupportCache = nil

local function getArenaSupport()
	if arenaSupportCache ~= nil then
		return arenaSupportCache
	end

	local playerScripts = player:FindFirstChild("PlayerScripts")
	local ui = playerScripts and playerScripts:FindFirstChild("UI")
	local twoD = ui and ui:FindFirstChild("2d")
	local arenaFolder = twoD and twoD:FindFirstChild("Arena")
	local settingsFolder = twoD and twoD:FindFirstChild("Settings")
	local packagesFolder = ReplicatedStorage:FindFirstChild("Packages")

	local arenaClient = safeRequireArena(
		arenaFolder and arenaFolder:FindFirstChild("ArenaClient")
	)

	local arenaState = safeRequireArena(
		arenaFolder and arenaFolder:FindFirstChild("ArenaState")
	)

	local arenaRankSettings = safeRequireArena(
		settingsFolder and settingsFolder:FindFirstChild("ArenaRankSettings")
	)

	-- Charm : uniquement pour s'abonner à ArenaState.result et fermer
	-- l'écran de résultat instantanément (voir startAutoArenaResultDismisser).
	-- Optionnel : son absence ne bloque pas Fight/Equip/Claim.
	local charm = safeRequireArena(
		packagesFolder and packagesFolder:FindFirstChild("Charm")
	)

	if type(arenaClient) ~= "table" or type(arenaState) ~= "table" then
		return nil
	end

	arenaSupportCache = {
		Client = arenaClient,
		State = arenaState,
		RankSettings = type(arenaRankSettings) == "table" and arenaRankSettings or nil,
		Charm = type(charm) == "table" and charm or nil,
	}

	return arenaSupportCache
end

-- ArenaClient.* (fight/claim/setTeam/refresh) finit en InvokeServer.
-- Si le serveur ne répond jamais, InvokeServer bloque la coroutine
-- appelante INDÉFINIMENT — pas d'erreur, juste un silence permanent.
-- pcall seul ne protège pas contre ça : il attend avec l'appel. Même
-- parade que invokeWithTimeout dans AutoTowerController plus haut dans
-- ce fichier : on isole l'appel dans sa propre coroutine et on poll un
-- flag avec un budget de temps -> jamais bloqué plus de timeoutSeconds.
local function invokeArenaWithTimeout(fn, timeoutSeconds, ...)
	if type(fn) ~= "function" then
		return false, "not_callable"
	end

	local args = {...}
	local done = false
	local ok, result

	task.spawn(function()
		ok, result = pcall(fn, unpack(args))
		done = true
	end)

	local waited = 0

	while not done and waited < timeoutSeconds do
		task.wait(0.1)
		waited = waited + 0.1
	end

	if not done then
		return false, "timeout after " .. tostring(timeoutSeconds) .. "s"
	end

	return ok, result
end

-- Attend qu'un atome Charm (ex. ArenaState.battling) satisfasse predicate,
-- via Charm.subscribe plutôt qu'un polling à intervalle fixe -> réaction
-- quasi instantanée (confirmé en live : le callback se déclenche de façon
-- synchrone dès que l'atome change) au lieu d'un délai d'attente initial +
-- un poll toutes les 0.1-0.25s. C'est ce qui faisait que le script mettait
-- du temps à "se rendre compte" qu'un combat avait démarré. shouldContinue
-- (optionnel) permet de sortir tôt si le worker a été désactivé entre
-- temps, sans garder l'abonnement actif inutilement.
local function waitForArenaCondition(charm, atom, predicate, timeoutSeconds, shouldContinue)
	if predicate(atom()) then
		return true
	end

	local satisfied = false
	local unsubscribe = nil

	if charm and type(charm.subscribe) == "function" then
		local ok, unsub = pcall(charm.subscribe, atom, function(value)
			if predicate(value) then
				satisfied = true
			end
		end)

		if ok and type(unsub) == "function" then
			unsubscribe = unsub
		end
	end

	local waited = 0

	while not satisfied
		and waited < timeoutSeconds
		and (not shouldContinue or shouldContinue()) do

		task.wait(0.05)
		waited = waited + 0.05

		-- Pas de Charm dispo (module introuvable) : on retombe sur un
		-- polling serré de l'atome lui-même.
		if not unsubscribe and predicate(atom()) then
			satisfied = true
		end
	end

	if unsubscribe then
		pcall(unsubscribe)
	end

	return satisfied or predicate(atom())
end

local lastArenaRefreshAt = 0

-- ArenaState.view() reste nil tant qu'aucun refresh n'a eu lieu.
-- ArenaController (toujours actif côté jeu) rafraîchit déjà après
-- chaque combat, donc ceci ne sert que d'amorce + filet de sécurité,
-- throttled pour ne jamais spam le remote ArenaGetView.
local function ensureArenaView(client, state)
	local view = state.view()

	if view ~= nil then
		return view
	end

	local now = os.clock()

	if now - lastArenaRefreshAt < ARENA_VIEW_REFRESH_COOLDOWN then
		return nil
	end

	lastArenaRefreshAt = now
	invokeArenaWithTimeout(client.refresh, AUTO_ARENA_REMOTE_TIMEOUT)

	return state.view()
end

local arenaResultUnsubscribe = nil

-- Ferme l'écran de résultat de combat dès qu'il apparaît (abonnement
-- Charm = instantané), au lieu d'attendre le prochain tick du worker
-- de fight — qui peut être en train d'attendre jusqu'à
-- AUTO_ARENA_BATTLE_TIMEOUT avant de repasser en haut de sa boucle.
local function startAutoArenaResultDismisser()
	if arenaResultUnsubscribe then
		return
	end

	local support = getArenaSupport()

	if not support
		or not support.Charm
		or type(support.Charm.subscribe) ~= "function" then

		return
	end

	local ok, unsubscribe = pcall(
		support.Charm.subscribe,
		support.State.result,
		function(value)
			if value ~= nil and autoArenaFightEnabled then
				support.State.result(nil)
			end
		end
	)

	if ok and type(unsubscribe) == "function" then
		arenaResultUnsubscribe = unsubscribe
	end
end

local function stopAutoArenaResultDismisser()
	if arenaResultUnsubscribe then
		pcall(arenaResultUnsubscribe)
		arenaResultUnsubscribe = nil
	end
end

local arenaStatus = arenaTab:CreateParagraph({
	Title = "Arena Status",
	Content = "Idle",
})

local function computeBestArenaIds(inventory, teamSize)
	local ids = {}

	for _, chicken in ipairs(inventory) do
		if #ids >= teamSize then
			break
		end

		if chicken and chicken.id ~= nil then
			table.insert(ids, chicken.id)
		end
	end

	return ids
end

local function idListsEqual(a, b)
	if #a ~= #b then
		return false
	end

	for i = 1, #a do
		if a[i] ~= b[i] then
			return false
		end
	end

	return true
end

