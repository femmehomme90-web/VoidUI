local function purchaseFeederOnce(feederId)
	if not BuyGenerator
		or not BuyGenerator.Parent
		or not BuyGenerator:IsA("RemoteFunction") then

		return false, "BuyGenerator RemoteFunction unavailable"
	end

	local id = math.clamp(
		math.floor(
			tonumber(feederId)
				or AUTO_PURCHASE_FEEDER_MIN_ID
		),
		AUTO_PURCHASE_FEEDER_MIN_ID,
		AUTO_PURCHASE_FEEDER_MAX_ID
	)

	local success, result = pcall(function()
		return BuyGenerator:InvokeServer(id)
	end)

	if not success or result == false then
		return false, result
	end

	return true, result
end

local function startAutoPurchaseFeederWorker()
	invalidateAutoPurchaseFeederWorker()
	local token = autoPurchaseFeederWorkerToken

	if not autoPurchaseFeederEnabled then
		return
	end

	task.spawn(function()
		while autoPurchaseFeederEnabled
			and token == autoPurchaseFeederWorkerToken
			and scriptAlive() do

			local snap = CoopSnapshot.get()

			-- On n'achète un générateur QUE quand le jeu dit que c'est
			-- possible (slots libres) ET qu'on peut le payer. Avant :
			-- 12 BuyGenerator:InvokeServer/s en dur sur des IDs 1..6
			-- (dont la plupart rejetés). Maintenant : 1 invoke ciblé,
			-- puis repos.
			local didBuy = false

			if snap
				and snap.canBuyGenerator(snap.slots, snap.feeders)
				and canAfford(snap.buyGeneratorCost(snap.feeders), snap.money) then

				local nextSlot = math.clamp(
					snap.feeders + 1,
					AUTO_PURCHASE_FEEDER_MIN_ID,
					AUTO_PURCHASE_FEEDER_MAX_ID
				)

				purchaseFeederOnce(nextSlot)
				didBuy = true
			end

			if autoPurchaseFeederEnabled
				and token == autoPurchaseFeederWorkerToken
				and scriptAlive() then

				task.wait(didBuy and AUTO_PURCHASE_FEEDER_CYCLE_DELAY or AUTO_COOP_IDLE_DELAY)
			end
		end
	end)
end

