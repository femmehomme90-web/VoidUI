-- Auto Equip Best Team
--========================================================

local function startAutoArenaEquipBestWorker()
	invalidateAutoArenaEquipBestWorker()
	local token = autoArenaEquipBestWorkerToken

	if not autoArenaEquipBestEnabled then
		return
	end

	task.spawn(function()
		while autoArenaEquipBestEnabled
			and token == autoArenaEquipBestWorkerToken
			and scriptAlive() do

			local support = getArenaSupport()

			if support then
				local client = support.Client
				local state = support.State
				local view = ensureArenaView(client, state)

				if type(view) == "table" then
					local inventory = view.inventory or {}
					local teamSize = tonumber(view.teamSize) or 3
					local currentTeamIds = view.teamIds or {}

					local bestIds =
						computeBestArenaIds(inventory, teamSize)

					if #bestIds > 0
						and not idListsEqual(bestIds, currentTeamIds) then

						invokeArenaWithTimeout(
							client.setTeam,
							AUTO_ARENA_REMOTE_TIMEOUT,
							bestIds
						)
					end
				end
			end

			task.wait(AUTO_ARENA_EQUIP_DELAY)
		end
	end)
end

--========================================================
-- Auto Claim Rewards
--========================================================

local function startAutoArenaClaimWorker()
	invalidateAutoArenaClaimWorker()
	local token = autoArenaClaimWorkerToken

	if not autoArenaClaimEnabled then
		return
	end

	task.spawn(function()
		while autoArenaClaimEnabled
			and token == autoArenaClaimWorkerToken
			and scriptAlive() do

			local support = getArenaSupport()

			if support then
				local client = support.Client
				local state = support.State
				local view = ensureArenaView(client, state)

				if type(view) == "table"
					and type(view.claimable) == "table" then

					local claimed = view.claimed

					for _, item in ipairs(view.claimable) do
						if not autoArenaClaimEnabled
							or token ~= autoArenaClaimWorkerToken
							or not scriptAlive() then

							break
						end

						local rankId = item and item.rankId

						local alreadyClaimed =
							type(claimed) == "table"
							and rankId ~= nil
							and claimed[rankId] == true

						if rankId ~= nil and not alreadyClaimed then
							invokeArenaWithTimeout(
								client.claim,
								AUTO_ARENA_REMOTE_TIMEOUT,
								rankId
							)
							task.wait(0.15)
						end
					end
				end
			end

			task.wait(AUTO_ARENA_CLAIM_DELAY)
		end
	end)
end

