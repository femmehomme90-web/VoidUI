local function getCurrentTowerFloor()
	if not towerSessionActive then
		lastCurrentTowerFloorSource = nil
		return nil
	end

	local stack = getTowerStackFolder()
	local completed = 0

	if stack then
		for _, child in ipairs(stack:GetChildren()) do
			if child:IsA("BasePart") then
				completed = completed + 1
			end
		end
	end

	lastCurrentTowerFloorSource = "TowerStack (session active)"
	return completed + 1
end


