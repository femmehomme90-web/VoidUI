--========================================================
-- COOP SNAPSHOT — état réel des générateurs du coop
--
-- Avant : les 3 workers coop (Upgrade / Buy / Expand) tiraient
-- UpgradeGenerator / BuyGenerator / ExpandCoop en boucle 0.10s sur les IDs
-- 1..6 en dur, sans jamais regarder si le feeder existe, s'il est déjà max,
-- ou si on a les Coins. Résultat pendant l'AutoFarm : ~35-40
-- RemoteFunction:InvokeServer par seconde (dont la moitié sur des slots
-- inexistants), la file de remotes Roblox sature -> micro-freezes. C'est la
-- cause des lags "au moment de l'amélioration automatique".
--
-- Maintenant : on lit l'état RÉPLIQUÉ du coop
-- (DataService.client:get({"coop"})) et on ne tire un remote QUE pour une
-- action réellement possible (feeder pas max ET abordable / slot achetable
-- ET abordable / expand possible ET abordable). Quand il n'y a rien à
-- faire, zéro trafic remote, la boucle dort.
--========================================================

local CoopSnapshot = (function()
	local clientCache, coopViewCache, genCfgCache

	local function getClient()
		if clientCache ~= nil then return clientCache or nil end
		local ds = GameModules.get("DataService", "ReplicatedStorage.Packages.DataService")
		clientCache = (type(ds) == "table" and ds.client) or false
		return clientCache or nil
	end

	local function getCoopView()
		if coopViewCache ~= nil then return coopViewCache or nil end
		coopViewCache = GameModules.get("CoopView", "ReplicatedStorage.Features.Coop.CoopView") or false
		return coopViewCache or nil
	end

	local function getGenCfg()
		if genCfgCache ~= nil then return genCfgCache or nil end
		local gc = GameModules.get("GameConfig", "ReplicatedStorage.Content.GameConfig")
		genCfgCache = (type(gc) == "table" and type(gc.generators) == "table" and gc.generators) or false
		return genCfgCache or nil
	end

	return {
		-- nil tant que l'état répliqué n'est pas prêt.
		get = function()
			local client = getClient()
			local coopView = getCoopView()
			local genCfg = getGenCfg()
			if not client or not coopView or not genCfg then return nil end

			local ok, coop = pcall(function() return client:get({ "coop" }) end)
			if not ok or type(coop) ~= "table" or type(coop.generators) ~= "table" then
				return nil
			end

			local generators = {}
			for _, g in ipairs(coop.generators) do
				local slot = tonumber(g.slot)
				local level = tonumber(g.level)
				if slot and level then
					table.insert(generators, {
						slot = slot, level = level, corn = tonumber(g.corn) or 0,
					})
				end
			end

			return {
				generators = generators,
				feeders = #generators,
				slots = tonumber(coop.slots) or #generators,
				money = getMoneyNumber(),
				maxLevel = tonumber(genCfg.maxLevel) or 50,
				maxSlots = tonumber(genCfg.maxSlots) or 6,
				upgradeCost = function(level)
					local okc, c = pcall(coopView.upgradeCost, level)
					return okc and c or nil
				end,
				buyGeneratorCost = function(feederCount)
					local okc, c = pcall(coopView.buyGeneratorCost, feederCount)
					return okc and c or nil
				end,
				expandCost = function(slots)
					local okc, c = pcall(coopView.expandCost, slots)
					return okc and c or nil
				end,
				canBuyGenerator = function(slots, feederCount)
					local okc, v = pcall(coopView.canBuyGenerator, slots, feederCount)
					return okc and v == true
				end,
				canExpand = function(slots)
					local okc, v = pcall(coopView.canExpand, slots)
					return okc and v == true
				end,
			}
		end,
	}
end)()

