--========================================================
-- EGGS — HATCH LADDER + HATCH INVENTORY
--
-- Deux systèmes d'oeufs distincts dans le jeu :
--   1. Oeufs "ladder" (feed/storm/crown/golden + barn starter) — hatchés
--      via HatchEgg:InvokeServer(tier), payés en Coins par le serveur,
--      pas besoin d'en posséder. "auto" = EggLadder.resolve() choisit le
--      palier selon la progression (tower best).
--   2. Oeufs d'inventaire (golden/colossus/void/hotEgg/... — cf.
--      Content.Catalog.eggs) — accumulés dans roster().eggs = {id=count},
--      hatchés via HatchEgg (x1) ou HatchEggs:InvokeServer(id, n) (batch,
--      n <= roster.hatch.batchMax = 10). Consomme l'inventaire.
--========================================================

local function rosterData()
	local dc = getDataController()
	if type(dc) ~= "table" or type(dc.roster) ~= "function" then
		return nil
	end
	local ok, r = pcall(dc.roster)
	if not ok or type(r) ~= "table" then
		return nil
	end
	return r
end

local function getOwnedEggs()
	local r = rosterData()
	if not r or type(r.eggs) ~= "table" then
		return {}
	end
	return r.eggs
end

local function hatchEgg(eggName)
	if not HatchEgg
		or not HatchEgg.Parent
		or not HatchEgg:IsA("RemoteFunction") then
		return false, "HatchEgg RemoteFunction unavailable"
	end

	local success, result = pcall(function()
		return HatchEgg:InvokeServer(eggName)
	end)

	if not success then
		return false, result
	end

	return true, result
end

local function hatchEggsBatch(eggName, count)
	if not HatchEggs
		or not HatchEggs.Parent
		or not HatchEggs:IsA("RemoteFunction") then
		return hatchEgg(eggName)
	end

	local n = math.clamp(math.floor(tonumber(count) or 1), 1, 10)

	local success, result = pcall(function()
		return HatchEggs:InvokeServer(eggName, n)
	end)

	if not success then
		return false, result
	end

	return true, result
end

