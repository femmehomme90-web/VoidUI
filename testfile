local fuseStatus = chickensTab:CreateParagraph({
	Title = "Fuse Status",
	Content = "Idle",
})

-- Cherche une paire à fusionner DANS UNE MÊME rareté (jamais deux
-- raretés différentes même si toutes deux cochées) — parcourt les
-- paliers cochés du moins rare au plus rare.
local function findFusePair(chickens, support, activeId)
	for _, rarity in ipairs(RARITY_TIERS) do
		if autoFuseRarities[rarity] then
			local first = nil

			for _, chicken in ipairs(chickens) do
				if chicken and chicken.id then
					local chickenRarity =
						getChickenRarity(chicken, support)

					if chickenRarity == rarity
						and not isProtectedChicken(chicken, activeId) then
						if not first then
							first = chicken
						elseif chicken.id ~= first.id then
							return first, chicken
						end
					end
				end
			end
		end
	end

	return nil, nil
end

local function startAutoFuseWorker()
	invalidateAutoFuseWorker()
	local token = autoFuseWorkerToken

	if not autoFuseEnabled then
		return
	end

	task.spawn(function()
		while autoFuseEnabled
			and token == autoFuseWorkerToken
			and scriptAlive() do

			local support = getChickenSupport()

			if not support then
				fuseStatus:Set({
					Title = "Fuse Status",
					Content = "Chicken scripts not found yet...",
				})

				task.wait(2)
			else
				local chickens = getRosterChickens(support)
				local activeId = getActiveChickenId(support)

				local chickenA, chickenB = nil, nil

				if chickens then
					chickenA, chickenB = findFusePair(chickens, support, activeId)
				end

				if not chickenA or not chickenB then
					fuseStatus:Set({
						Title = "Fuse Status",
						Content = "Not enough matching chickens to fuse",
					})

					task.wait(autoFuseIntervalSeconds)
				else
					-- locks = {} (aucun trait verrouillé), cosmétique
					-- pris sur chickenA par défaut : reproduit une
					-- fusion "par défaut" sans passer par l'UI de
					-- verrouillage de traits (fonctionnalité premium,
					-- hors scope de cette automatisation).
					local fuseOk, fuseResult =
						invokeChickenRemoteWithTimeout(
							FuseChickens,
							CHICKEN_REMOTE_TIMEOUT,
							chickenA.id,
							chickenB.id,
							{},
							nil,
							"a"
						)

					if fuseOk
						and type(fuseResult) == "table"
						and fuseResult.ok then

						local resultRarity =
							type(fuseResult.data) == "table"
								and fuseResult.data.rarity
								or "?"

						fuseStatus:Set({
							Title = "Fuse Status",
							Content = "Fused · result rarity: "
								.. tostring(resultRarity),
						})
					else
						fuseStatus:Set({
							Title = "Fuse Status",
							Content = "Fuse failed: "
								.. describeRemoteFailure(fuseOk, fuseResult),
						})
					end

					task.wait(autoFuseIntervalSeconds)
				end
			end
		end
	end)
end

