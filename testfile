local function safeRequireChicken(moduleScript)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end

	local ok, result = pcall(require, moduleScript)
	if not ok then
		return nil
	end

	return result
end

-- Caché uniquement en cas de succès, même logique que getArenaSupport
-- plus bas dans ce fichier : on retente tant que les modules ne sont
-- pas encore chargés plutôt que de figer un échec définitif.
local chickenSupportCache = nil

local function getChickenSupport()
	if chickenSupportCache ~= nil then
		return chickenSupportCache
	end

	local playerScripts = player:FindFirstChild("PlayerScripts")
	local core = playerScripts and playerScripts:FindFirstChild("Core")
	local dataFolder = core and core:FindFirstChild("Data")
	local dataControllerModule = dataFolder and dataFolder:FindFirstChild("DataController")

	local content = ReplicatedStorage:FindFirstChild("Content")
	local catalogModule = content and content:FindFirstChild("Catalog")

	local dataController = safeRequireChicken(dataControllerModule)
	local catalog = safeRequireChicken(catalogModule)

	if type(dataController) ~= "table"
		or type(dataController.roster) ~= "function" then

		return nil
	end

	chickenSupportCache = {
		DataController = dataController,
		ChickenTypes = type(catalog) == "table" and catalog.chickenTypes or nil,
		DefaultChickenType = type(catalog) == "table" and catalog.defaultChickenType or nil,
	}

	return chickenSupportCache
end

-- Même repli que CollectionWindow.sellValueOf : un poulet n'a pas
-- toujours un champ .rarity propre (ex. poulet de base jamais fusionné),
-- dans ce cas c'est la rareté de son typeId dans le Catalog qui compte.
local function getChickenRarity(chicken, support)
	if not chicken then
		return nil
	end

	if chicken.rarity then
		return chicken.rarity
	end

	local chickenType = nil

	if support and support.ChickenTypes and chicken.typeId then
		chickenType = support.ChickenTypes[chicken.typeId]
	end

	if not chickenType and support then
		chickenType = support.DefaultChickenType
	end

	return chickenType and chickenType.rarity or nil
end

-- IMPORTANT (vérifié en lisant DataController.lua directement) :
-- DataController.roster() ne renvoie PAS un tableau de poulets — c'est
-- rosterView(client:get({"roster"})), un objet {chickens = {...},
-- activeId = ..., owned = ..., ownedAbilities = ..., outfits = ...}.
-- Les poulets sont dans .chickens. Itérer directement sur le retour de
-- roster() avec ipairs() ne trouve donc jamais rien (table sans partie
-- tableau) — c'est ce qui faisait que rien n'était jamais détecté.
local function getRosterChickens(support)
	if not support or type(support.DataController.roster) ~= "function" then
		return nil
	end

	local ok, roster = pcall(support.DataController.roster)

	if not ok or type(roster) ~= "table" or type(roster.chickens) ~= "table" then
		return nil
	end

	return roster.chickens
end

local function getActiveChickenId(support)
	if not support or type(support.DataController.roster) ~= "function" then
		return nil
	end

	local ok, roster = pcall(support.DataController.roster)
	if not ok or type(roster) ~= "table" then
		return nil
	end

	return roster.activeId
end

-- true si le poulet doit être épargné par sell / fuse / consommation de
-- promotion (favori protégé, poulet actif protégé, ou poulet muté protégé).
local function isProtectedChicken(chicken, activeId)
	if not chicken then
		return true
	end

	if chickenSkipFavorites and chicken.favorite == true then
		return true
	end

	if chickenProtectActive
		and activeId ~= nil
		and chicken.id == activeId then
		return true
	end

	if chickenProtectInverted and chicken.mutation ~= nil then
		return true
	end

	return false
end

-- InvokeServer bloque la coroutine appelante indéfiniment si le serveur
-- ne répond jamais — même défaut que ArenaFight/UpgradeGenerator ailleurs
-- dans ce fichier. Borne l'attente pour ne jamais geler ces boucles.
--
-- FuseChickens reçoit un nil AU MILIEU de ses arguments (id, id, locks,
-- nil, cosmétique) : un simple {...} + unpack(args) se fierait à #args,
-- qui est indéfini dès qu'une table a un "trou" (nil suivi d'une valeur
-- non-nil) — risque réel de perdre le dernier argument. table.pack
-- capture le vrai compte via .n, table.unpack(args, 1, args.n) le
-- respecte explicitement.
local function invokeChickenRemoteWithTimeout(remote, timeoutSeconds, ...)
	if not remote or not remote.Parent then
		return false, "remote unavailable"
	end

	local args = table.pack(...)
	local done = false
	local ok, result

	task.spawn(function()
		ok, result = pcall(function()
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end)
		done = true
	end)

	local waited = 0

	while not done and waited < timeoutSeconds do
		task.wait(0.1)
		waited = waited + 0.1
	end

	if not done then
		return false, "timeout after " .. tostring(timeoutSeconds) .. "s"
	end

	return ok, result
end

local function describeRemoteFailure(ok, result)
	if type(result) == "table" and result.error ~= nil then
		return tostring(result.error)
	elseif not ok then
		return tostring(result)
	end

	return "unknown"
end

