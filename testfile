local sellStatus = chickensTab:CreateParagraph({
	Title = "Sell Status",
	Content = "Idle",
})

local function startAutoSellWorker()
	invalidateAutoSellWorker()
	local token = autoSellWorkerToken

	if not autoSellEnabled then
		return
	end

	task.spawn(function()
		while autoSellEnabled
			and token == autoSellWorkerToken
			and scriptAlive() do

			local support = getChickenSupport()

			if not support then
				setParagraph(sellStatus, "Sell Status",
					"Chicken scripts not found yet...")

				task.wait(2)
			else
				local chickens = getRosterChickens(support)
				local activeId = getActiveChickenId(support)
				local idsToSell = {}

				if chickens then
					for _, chicken in ipairs(chickens) do
						if #idsToSell >= AUTO_SELL_BATCH_SIZE then
							break
						end

						if chicken and chicken.id then
							local rarity = getChickenRarity(chicken, support)

							local level = tonumber(chicken.level) or 1
							local levelOk =
								autoSellMaxLevel <= 0
								or level <= autoSellMaxLevel

							if rarity
								and autoSellRarities[rarity]
								and levelOk
								and not isProtectedChicken(chicken, activeId) then

								table.insert(idsToSell, chicken.id)
							end
						end
					end
				end

				if #idsToSell == 0 then
					setParagraph(sellStatus, "Sell Status", "Nothing to sell")

					task.wait(autoSellIntervalSeconds)
				else
					local sellOk, sellResult =
						invokeChickenRemoteWithTimeout(
							SellChickens,
							CHICKEN_REMOTE_TIMEOUT,
							idsToSell
						)

					if sellOk
						and type(sellResult) == "table"
						and sellResult.ok then

						local count =
							type(sellResult.data) == "table"
								and sellResult.data.count
								or #idsToSell

						sellStatus:Set({
							Title = "Sell Status",
							Content = "Sold " .. tostring(count) .. " chicken(s)",
						})
					else
						sellStatus:Set({
							Title = "Sell Status",
							Content = "Sell failed: "
								.. describeRemoteFailure(sellOk, sellResult),
						})
					end

					task.wait(autoSellIntervalSeconds)
				end
			end
		end
	end)
end

