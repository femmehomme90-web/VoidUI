	local updateFloorStatuses
	local markRebirthComplete

	local function startAutomationFeatureWorkers()
		invalidateAutomationFeatureWorkers()
		local token = automationFeatureWorkerToken

		-- Runtime Rebirth toujours actif dès que Automation tourne.
		task.spawn(function()
			local runtimeLastRebirthCount =
				getRebirthCount()

			local runtimeRequirementBefore =
				nil

			while automationEnabled
				and token == automationFeatureWorkerToken
				and scriptAlive() do

				local now = os.clock()

				local rebirthCount =
					getRebirthCount()

				local requiredFloor =
					detectRequiredRebirthFloor()

				local currentFloor =
					AutoTowerController:GetCurrentFloor()

				local towerBest =
					getTowerBestFloor()

				local rebirthUi =
					getRebirthUiState()

				local rebirthRuntimeCoolingDown =
					now < postRebirthHoldUntil

				if not requiredFloor
					and rebirthUi.requiredFloor then

					requiredFloor =
						rebirthUi.requiredFloor

					requiredRebirthFloorCache =
						requiredFloor
				end

				if not towerBest
					and rebirthUi.progressFloor then

					towerBest =
						rebirthUi.progressFloor
				end

				updateFloorStatuses(
					requiredFloor,
					currentFloor,
					towerBest
				)

				if currentFloor ~= fightTimeoutFloor then
					fightTimeoutFloor = currentFloor
					fightTimeoutStartedAt = now
					lastFightTimeoutSurrenderAt = 0
				end

				if not currentFloor then
					fightTimeoutStatus:Set({
						Title = "Fight Timeout",
						Content = "Waiting for Tower",
					})
				elseif not requiredFloor then
					fightTimeoutStatus:Set({
						Title = "Fight Timeout",
						Content = "Waiting for Required Rebirth Floor",
					})
				end

				if not currentFloor
					and not rebirthUi.rebirthReady
					and (
						requiredFloor == nil
						or towerBest == nil
					) then

					waitingForRebirth = false
					runtimeRequirementBefore = nil
					coopStableSince = nil
					rebirthAttemptedAfterReturn = false
				end

				if rebirthUi.rebirthReady
					and now - lastRebirthAttemptAt
						>= AUTOMATION_REBIRTH_RETRY_DELAY then

					local rebirthOk, rebirthResult =
						rebirthOnce()

					lastRebirthAttemptAt = now
					rebirthAttemptedAfterReturn = true

					if rebirthOk
						and rebirthResult ~= false then

						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "REBIRTH button ready · invoking now",
						})
					else
						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "REBIRTH ready · retrying...",
						})
					end
				end

				if runtimeLastRebirthCount ~= nil
					and rebirthCount ~= nil
					and rebirthCount
						> runtimeLastRebirthCount then

					runtimeLastRebirthCount =
						rebirthCount

					markRebirthComplete(now)

					runtimeRequirementBefore =
						nil

				elseif rebirthCount ~= nil then
					runtimeLastRebirthCount =
						rebirthCount
				end

				-- IN TOWER — dynamique complet :
				-- A = requiredFloor, B = currentFloor
				-- B <= A : continue le combat
				-- B >  A : surrender + retour Coop
				if not rebirthRuntimeCoolingDown
					and requiredFloor
					and currentFloor
					and currentFloor > requiredFloor then

					if not waitingForRebirth then
						waitingForRebirth = true

						lastRebirthAttemptAt = 0
						lastCoopOrderAt = 0
						coopStableSince = nil
						rebirthAttemptedAfterReturn = false
						lastDynamicSurrenderAt = 0
					end

					if now - lastDynamicSurrenderAt
						>= AUTOMATION_DYNAMIC_SURRENDER_DELAY then

						AutoTowerController:SurrenderOnce()
						AutoTowerController:DeclineOnce()
						callChickenToCoopOnce()

						lastDynamicSurrenderAt = now
						lastCoopOrderAt = now

						fightTimeoutStatus:Set({
							Title = "Fight Timeout",
							Content = "Bypassed · B > A",
						})

						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "B="
								.. tostring(currentFloor)
								.. " > A="
								.. tostring(requiredFloor)
								.. " · SURRENDER + COOP",
						})
					end

				-- FIGHT TIMEOUT : B < A -> timeout par floor
				elseif not rebirthRuntimeCoolingDown
					and currentFloor
					and requiredFloor
					and currentFloor < requiredFloor then

					local elapsed =
						math.max(
							0,
							now - fightTimeoutStartedAt
						)

					local remaining =
						math.max(
							0,
							fightTimeout - elapsed
						)

					if remaining > 0 then
						fightTimeoutStatus:Set({
							Title = "Fight Timeout",
							Content = "Floor "
								.. tostring(currentFloor)
								.. " · "
								.. string.format("%.1f", remaining)
								.. "s remaining",
						})
					else
						fightTimeoutStatus:Set({
							Title = "Fight Timeout",
							Content = "Floor "
								.. tostring(currentFloor)
								.. " timed out · RETREAT",
						})

						if now - lastFightTimeoutSurrenderAt
							>= AUTOMATION_FIGHT_TIMEOUT_RETRY_DELAY then

							AutoTowerController:SurrenderOnce()
							AutoTowerController:DeclineOnce()

							lastFightTimeoutSurrenderAt = now

							cycleStatus:Set({
								Title = "Cycle Status",
								Content = "Fight Timeout · Floor "
									.. tostring(currentFloor)
									.. " → RETREAT",
							})
						end
					end

				elseif not rebirthRuntimeCoolingDown
					and currentFloor
					and requiredFloor
					and currentFloor == requiredFloor then

					fightTimeoutStatus:Set({
						Title = "Fight Timeout",
						Content = "Disabled at required floor "
							.. tostring(requiredFloor),
					})

				-- OUTSIDE TOWER : éligibilité Rebirth toujours vérifiée.
				elseif not rebirthRuntimeCoolingDown
					and not currentFloor
					and requiredFloor
					and towerBest
					and towerBest >= requiredFloor then

					if not waitingForRebirth then
						waitingForRebirth = true

						runtimeRequirementBefore =
							requiredFloor

						lastRebirthAttemptAt = 0
						lastCoopOrderAt = 0
						coopStableSince = nil
						rebirthAttemptedAfterReturn = false

						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "Rebirth runtime eligible "
								.. tostring(towerBest)
								.. " / "
								.. tostring(requiredFloor),
						})
					end

					if now - lastCoopOrderAt
						>= AUTOMATION_COOP_ORDER_DELAY then

						callChickenToCoopOnce()
						lastCoopOrderAt = now
					end

					if rebirthUi.needsRoosterHome then
						coopStableSince = nil

						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "Rebirth ready · rooster not home",
						})
					else
						if not coopStableSince then
							coopStableSince = now
						end
					end

					local stableAtHome =
						coopStableSince ~= nil
						and now - coopStableSince >= 1.50

					local homeConfirmed =
						rebirthUi.rebirthReady
						or (
							not rebirthUi.needsRoosterHome
							and stableAtHome
						)

					if homeConfirmed
						and now - lastRebirthAttemptAt
							>= AUTOMATION_REBIRTH_RETRY_DELAY then

						local rebirthOk, rebirthResult =
							rebirthOnce()

						lastRebirthAttemptAt = now
						rebirthAttemptedAfterReturn = true

						if rebirthOk
							and rebirthResult ~= false then

							cycleStatus:Set({
								Title = "Cycle Status",
								Content = "Rebirth sent · confirming...",
							})
						else
							cycleStatus:Set({
								Title = "Cycle Status",
								Content = "Rebirth retry...",
							})
						end
					end

					if rebirthAttemptedAfterReturn
						and runtimeRequirementBefore
						and requiredFloor
						and requiredFloor
							~= runtimeRequirementBefore then

						markRebirthComplete(now)
						runtimeRequirementBefore = nil
					end

				else
					if waitingForRebirth
						and (
							not requiredFloor
							or (
								towerBest
								and towerBest < requiredFloor
							)
						) then

						waitingForRebirth = false
						coopStableSince = nil
						rebirthAttemptedAfterReturn = false
						runtimeRequirementBefore = nil
					end
				end

				task.wait(AUTOMATION_POLL_DELAY)
			end
		end)
	end

	updateFloorStatuses = function(requiredFloor, currentFloor, towerBest)
		-- Appelé à 0.10s dans DEUX workers (jusqu'à 20x/s) sur 3
		-- Paragraphs — via setParagraph pour ne pousser un :Set que
		-- quand la valeur change vraiment (sinon reflow inutile du
