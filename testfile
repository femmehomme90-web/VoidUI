-- Auto Promote
-- PromoteChicken(targetId, {consumeIds}). Cible = poulet actif ou plus
-- haute rareté. Candidats sacrifiables = même typeId, pas la cible, pas
-- l'actif, pas favori, pas protégé (isProtectedChicken -> couvre inverted).
-- On consomme exactement `need - dupes` par cycle (une étoile), comme l'UI.
--========================================================

local promoteStatus = chickensTab:CreateParagraph({
	Title = "Promote Status",
	Content = "Idle",
})

local function getPromotionView()
	return GameModules.get(
		"PromotionView", "ReplicatedStorage.Features.Chicken.PromotionView"
	)
end

local function pickPromoteTarget(chickens, support, activeId)
	if autoPromoteTarget == "Active Chicken" then
		if not activeId then return nil end
		for _, c in ipairs(chickens) do
			if c.id == activeId then return c end
		end
		return nil
	end

	-- "Highest Rarity" : rareté la plus haute (RARITY_TIERS = ordre
	-- croissant), départage par nombre de doublons dispo.
	local rank = {}
	for i, r in ipairs(RARITY_TIERS) do rank[r] = i end

	local best, bestRank = nil, -1
	for _, c in ipairs(chickens) do
		if c.id then
			local r = getChickenRarity(c, support)
			local ri = (r and rank[r]) or 0
			if ri > bestRank then
				best, bestRank = c, ri
			end
		end
	end
	return best
end

local function startAutoPromoteWorker()
	invalidateAutoPromoteWorker()
	local token = autoPromoteWorkerToken

	if not autoPromoteEnabled then
		return
	end

	task.spawn(function()
		while autoPromoteEnabled
			and token == autoPromoteWorkerToken
			and scriptAlive() do

			local support = getChickenSupport()
			local pv = getPromotionView()

			if not support or not PromoteChicken or type(pv) ~= "table" then
				setParagraph(promoteStatus, "Promote Status",
					(not PromoteChicken) and "PromoteChicken remote missing"
						or (type(pv) ~= "table") and "PromotionView not loaded"
						or "Chicken scripts not found yet...")
				task.wait(2)
			else
				local chickens = getRosterChickens(support)
				local activeId = getActiveChickenId(support)
				local target = chickens
					and pickPromoteTarget(chickens, support, activeId)

				if not target then
					setParagraph(promoteStatus, "Promote Status",
						"No promote target")
					task.wait(autoPromoteIntervalSeconds)
				else
					local rarity = getChickenRarity(target, support)
					local stars = 0
					local dupes = 0
					pcall(function() stars = pv.stars(target) or 0 end)
					pcall(function() dupes = pv.dupes(target) or 0 end)

					local cap = math.clamp(
						math.floor(tonumber(autoPromoteMaxStars) or 10), 1, 10)

					if stars >= cap or stars >= 10 then
						setParagraph(promoteStatus, "Promote Status",
							"Target at " .. tostring(stars) .. "* — done")
						task.wait(autoPromoteIntervalSeconds)
					else
						local need = nil
						pcall(function()
							need = pv.requirement(rarity, stars + 1)
						end)

						if not need or need <= 0 then
							setParagraph(promoteStatus, "Promote Status",
								"Can't read star requirement")
							task.wait(autoPromoteIntervalSeconds)
						else
							local want = math.max(0, need - dupes)

							local pool = {}
							for _, c in ipairs(chickens) do
								if c.id
									and c.id ~= target.id
									and c.typeId == target.typeId
									and c.id ~= activeId
									and c.favorite ~= true
									and not isProtectedChicken(c, activeId) then
									pool[#pool + 1] = c.id
								end
							end

							if #pool < want then
								setParagraph(promoteStatus, "Promote Status",
									"Need " .. tostring(want - #pool)
										.. " more dupe(s) of "
										.. tostring(target.typeId)
										.. " for " .. tostring(stars + 1) .. "*")
								task.wait(autoPromoteIntervalSeconds)
							else
								local consume = {}
								for i = 1, want do consume[i] = pool[i] end

								local ok, res = invokeChickenRemoteWithTimeout(
									PromoteChicken,
									CHICKEN_REMOTE_TIMEOUT,
									target.id,
									consume
								)

								if ok and type(res) == "table" and res.ok then
									setParagraph(promoteStatus, "Promote Status",
										"Promoted "
											.. tostring(target.nickname or target.typeId)
											.. " to " .. tostring(stars + 1)
											.. "* (-" .. tostring(want) .. " dupe)")
								else
									setParagraph(promoteStatus, "Promote Status",
										"Promote failed: "
											.. describeRemoteFailure(ok, res))
								end

								task.wait(autoPromoteIntervalSeconds)
							end
						end
					end
				end
			end
		end
	end)
end

