local workerToken = 0

local function invalidateWorker()
	workerToken = workerToken + 1
end

local function resolveLadderTier()
	if ladderTier ~= EGG_LADDER_AUTO then
		return ladderTier
	end

	-- "auto" -> palier selon la progression, comme le jeu (EggLadder).
	local ladder = GameModules.get(
		"EggLadder", "ReplicatedStorage.Features.Chicken.EggLadder"
	)
	local dc = getDataController()
	local best = 0
	if type(dc) == "table" and type(dc.towerBest) == "function" then
		local ok, v = pcall(dc.towerBest)
		if ok then best = tonumber(v) or 0 end
	end

	if type(ladder) == "table" and type(ladder.resolve) == "function" then
		local ok, tier = pcall(ladder.resolve, ladder.AUTO or "auto", best)
		if ok and type(tier) == "string" then
			return tier
		end
	end

	-- Fallback : palier feed/storm/crown/golden selon best (floors 0/15/35/60).
	if best >= 60 then return "golden" end
	if best >= 35 then return "crown" end
	if best >= 15 then return "storm" end
	return "feed"
end

