		})
	end

	local function startAutomationWorker()
		invalidateAutomationWorker()
		local token = automationWorkerToken

		if not automationEnabled then
			return
		end

		-- Architecture SINGLE-OWNER : aucun worker générique ne peut
		-- concurrencer ce scheduler.
		forceRoutineCoreOn()
		startAutomationFeatureWorkers()

		local now = os.clock()
		postRebirthHoldUntil = now
		nextTowerStartAt = 0
		towerLoopCountdownActive = false
		towerStartPending = false
		towerStartPendingUntil = 0
		waitingForRebirth = false
		towerWasActive = false
		lastRebirthAttemptAt = 0
		lastCoopOrderAt = 0
		coopStableSince = nil
		rebirthAttemptedAfterReturn = false
		lastDynamicSurrenderAt = 0
		fightTimeoutFloor = nil
		fightTimeoutStartedAt = 0
		lastFightTimeoutSurrenderAt = 0

		fightTimeoutStatus:Set({
			Title = "Fight Timeout",
			Content = "Waiting for Tower",
		})

		cycleStatus:Set({
			Title = "Cycle Status",
			Content = "Routine ON · Coop workers looping + Tower scheduler",
		})

		task.spawn(function()
			while automationEnabled
				and token == automationWorkerToken
				and scriptAlive() do

				local now = os.clock()

				local requiredFloor =
					detectRequiredRebirthFloor()

				local currentFloor =
					AutoTowerController:GetCurrentFloor()

				local towerBest =
					getTowerBestFloor()

				local rebirthUi =
					getRebirthUiState()

				if not requiredFloor
					and rebirthUi.requiredFloor then

					requiredFloor =
						rebirthUi.requiredFloor

					requiredRebirthFloorCache =
						requiredFloor
				end

				if not towerBest
					and rebirthUi.progressFloor then

					towerBest =
						rebirthUi.progressFloor
				end

				updateFloorStatuses(
					requiredFloor,
					currentFloor,
					towerBest
				)

				local inTower =
					currentFloor ~= nil

				local realRebirthEligibleOutside =
					not inTower
					and requiredFloor ~= nil
					and towerBest ~= nil
					and towerBest >= requiredFloor

				local towerLoopDelayValue =
					getAutomationTowerLoopDelay()

				if towerStartPending
					and inTower then

					towerStartPending = false
					towerStartPendingUntil = 0
				end

				if towerWasActive
					and not inTower then

					AutoTowerController:DeclineOnce()
					callChickenToCoopOnce()

					towerLoopCountdownActive = true
					towerStartPending = false
					towerStartPendingUntil = 0
					nextTowerStartAt =
						now + towerLoopDelayValue
				end

				towerWasActive = inTower

				if not waitingForRebirth
					and not realRebirthEligibleOutside then

					if inTower then
						towerLoopCountdownActive = false
						towerStartPending = false
						towerStartPendingUntil = 0
						nextTowerStartAt = 0

						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "Waiting to Coop · Tower Loop Delay "
								.. tostring(towerLoopDelayValue)
								.. "s",
						})

					elseif towerStartPending
						and now < towerStartPendingUntil then

						cycleStatus:Set({
							Title = "Cycle Status",
							Content = "TowerStart sent · waiting for Tower",
						})

					else
						if towerStartPending
							and now >= towerStartPendingUntil then

							towerStartPending = false
							towerStartPendingUntil = 0
						end

						if not towerLoopCountdownActive then
							towerLoopCountdownActive = true
							nextTowerStartAt =
								now + towerLoopDelayValue
						end

						local remaining =
							math.max(
								0,
								nextTowerStartAt - now
							)

						if remaining > 0 then
							cycleStatus:Set({
								Title = "Cycle Status",
								Content = "Tower starts in "
									.. string.format(
										"%.1f",
										remaining
									)
									.. "s",
							})
						end

						if now >= postRebirthHoldUntil
							and towerLoopCountdownActive
							and now >= nextTowerStartAt then

							local latestRequired =
								detectRequiredRebirthFloor()

							local latestTowerBest =
								getTowerBestFloor()

							local becameReallyEligible =
								latestRequired ~= nil
								and latestTowerBest ~= nil
								and latestTowerBest >= latestRequired

							if not waitingForRebirth
								and not becameReallyEligible then

								local started =
									AutoTowerController:StartOnce()

								if started then
									towerLoopCountdownActive = false
									nextTowerStartAt = 0
									towerStartPending = true
									towerStartPendingUntil =
										os.clock() + 5

									cycleStatus:Set({
										Title = "Cycle Status",
										Content = "TowerStart sent · waiting for Tower",
									})
								else
									towerLoopCountdownActive = true
									nextTowerStartAt =
										os.clock()
										+ towerLoopDelayValue

									cycleStatus:Set({
										Title = "Cycle Status",
										Content = "TowerStart rejected · retry in "
											.. tostring(towerLoopDelayValue)
											.. "s",
									})
								end
							end
						end
					end

				elseif realRebirthEligibleOutside then
					towerLoopCountdownActive = false
					towerStartPending = false
					towerStartPendingUntil = 0
					nextTowerStartAt = 0

					cycleStatus:Set({
						Title = "Cycle Status",
						Content = "Rebirth eligible · Tower paused",
					})
				end

				if AUTOMATION_DEBUG_LOG then
					local remainingDbg =
						math.max(0, nextTowerStartAt - now)

					print(
						("[AutoFarm DEBUG] t=%.1f inTower=%s waitingForRebirth=%s realRebirthEligibleOutside=%s towerStartPending=%s towerLoopCountdownActive=%s remaining=%.1f req=%s cur=%s best=%s")
						:format(
							now,
							tostring(inTower),
							tostring(waitingForRebirth),
							tostring(realRebirthEligibleOutside),
							tostring(towerStartPending),
							tostring(towerLoopCountdownActive),
							remainingDbg,
							tostring(requiredFloor),
							tostring(currentFloor),
							tostring(towerBest)
						)
					)
				end

				task.wait(AUTOMATION_POLL_DELAY)
			end
		end)
	end

	local function stopAutomationWorker(shuttingDown)
		invalidateAutomationWorker()
		invalidateAutomationFeatureWorkers()
		waitingForRebirth = false
		coopStableSince = nil
		rebirthAttemptedAfterReturn = false
		lastDynamicSurrenderAt = 0
		fightTimeoutFloor = nil
		fightTimeoutStartedAt = 0
		lastFightTimeoutSurrenderAt = 0

		fightTimeoutStatus:Set({
			Title = "Fight Timeout",
			Content = "Stopped",
		})

		Window.AutomationRunning = false

		if not shuttingDown then
			forceRoutineCoreOff()
		end

		cycleStatus:Set({
			Title = "Cycle Status",
			Content = shuttingDown and "Closing" or "Stopped",
		})
	end

	automationTab:CreateToggle({
		Name = "Automation",
		CurrentValue = automationEnabled,
		Flag = "AutomationEnabled",

		Callback = function(enabled)
			automationEnabled = enabled
			AutomationEnabledFlag = enabled
			Window.AutomationRunning = enabled

			if enabled then
				startAutomationWorker()
			else
				stopAutomationWorker(false)
			end
		end,
	})

	return {
		StartFromConfig = function()
			Window.AutomationRunning = automationEnabled == true
			if automationEnabled then
				startAutomationWorker()
			else
				updateFloorStatuses(
					detectRequiredRebirthFloor(),
					AutoTowerController:GetCurrentFloor(),
					getTowerBestFloor()
				)
			end
		end,
		Stop = function(shuttingDown)
			automationEnabled = false
			stopAutomationWorker(shuttingDown == true)
		end,
	}
end)()

--========================================================
-- WORLD EVENTS (UFO / Hot Egg / Golden Goose / Chicken Boss)
--
-- Le cycle world-event (GameConfig.worldEvents : cycle 600s, warmup 60s,
-- live 180s) est 100% serveur. Le client apprend l'état via des attributs
-- sur Workspace (cf. PlayerScripts.UI.2d.event.EventState) :
--   EventId       -> clé de worldEvents.defs (ufo / hotEgg / goldenGoose / chickenBoss)
--   EventPhase    -> "idle" | "warmup" | "live"
--   EventDeadline -> os time (Workspace:GetServerTimeNow()) de fin de phase
--
-- L'event UFO en particulier : le vaisseau abduct 4 poulets, MUTE leurs
-- gènes (bonus de puissance permanent) et les empoisonne temporairement
-- (poison ~450s) — tout est côté serveur, aucun remote à "claim". Les
-- oeufs largués par l'UFO sont des NestEgg normaux : l'Auto Collect Egg
-- (onglet Eggs, option "Collect Any Owner") les ramasse déjà.
--
-- Ce panneau est donc informatif : il dit quel event tourne et le temps
-- restant, pour tous les world events.
--========================================================

local WorldEventController = (function()
	local eventStatus = eventsTab:CreateParagraph({
		Title = "World Event",
		Content = "Detecting...",
	})

	eventsTab:CreateParagraph({
		Title = "About the UFO Invasion",
		Content = "Server-run: the UFO beams up 4 coop chickens, permanently "
			.. "mutates their genes (power buff) and briefly poisons them. "
			.. "Nothing to click. Eggs it drops are normal NestEggs — enable "
			.. "Eggs > Auto Collect Egg (+ Collect Any Owner) to sweep them.",
	})

	local function phaseLabel(phase)
		if phase == "live" then return "LIVE" end
		if phase == "warmup" then return "warming up" end
		if phase == "idle" then return "idle" end
		return tostring(phase or "?")
	end

	local function tick()
		local id = workspace:GetAttribute("EventId")
		local phase = workspace:GetAttribute("EventPhase")
		local deadline = tonumber(workspace:GetAttribute("EventDeadline"))

		if not id then
			setParagraph(eventStatus, "World Event", "No world event data")
			return
		end

		local name = WORLD_EVENT_NAMES[id] or tostring(id)
		local content = name .. " · " .. phaseLabel(phase)

		if deadline then
			local remaining = math.max(0, deadline - workspace:GetServerTimeNow())
			local mins = math.floor(remaining / 60)
			local secs = math.floor(remaining % 60)
			content = content .. " · " .. string.format("%d:%02d", mins, secs)
				.. (phase == "live" and " left" or " to go")
		end

		setParagraph(eventStatus, "World Event", content)
	end

	return {
		Start = function()
			task.spawn(function()
				while scriptAlive() do
					tick()
					task.wait(1)
				end
			end)
		end,
	}
end)()

