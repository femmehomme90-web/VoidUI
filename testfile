local autoBuyFeederEnabled = false
local autoUpgradeFeederCPS = 5
local autoBuyFeederWorkerToken = 0

-- Pré-déclaré : assigné plus bas (après le slider/toggle, pour l'ordre
-- visuel), mais startAutoBuyFeederWorker le référence avant ce point.
-- Sans ce forward-declare, Lua résoudrait la référence en globale (nil)
-- au lieu de capturer la bonne locale — même piège que
-- updateFloorStatuses/markRebirthComplete plus bas dans ce fichier.
local upgradeFeederStatus

-- Bornes de slot du coop (1..maxSlots). Servent uniquement à clamp l'ID
-- envoyé au remote ; la liste réelle vient de CoopSnapshot.
local AUTO_UPGRADE_FEEDER_MIN_ID = 1
local AUTO_UPGRADE_FEEDER_MAX_ID = 6

-- Délai entre deux upgrades. AutoFarm garde un rythme serré (0.10s) — sans
-- danger maintenant qu'on ne tire plus rien sur les feeders déjà max.
local function getAutoUpgradeFeederDelay()
	if Window.AutomationRunning then
		return 0.10
	end

	return 0.5 / math.clamp(autoUpgradeFeederCPS, 1, 50)
end

-- Boucle "rien à faire" : on dort ce délai sans tirer AUCUN remote.
local AUTO_COOP_IDLE_DELAY = 1.0

local function invalidateAutoBuyFeederWorker()
	autoBuyFeederWorkerToken = autoBuyFeederWorkerToken + 1
end

local UPGRADE_FEEDER_REMOTE_TIMEOUT = 5

-- InvokeServer bloque la coroutine appelante indéfiniment si le serveur ne
-- répond jamais (même défaut que ArenaFight, voir la section Auto Arena
-- plus bas) — borne l'attente pour ne jamais geler cette boucle. Renvoie
-- aussi le temps de réponse réel : la lenteur rapportée sur cette feature
-- ("~1 upgrade/s par ID") est très probablement ce délai serveur, pas la
-- boucle elle-même (qui n'ajoute que getAutoUpgradeFeederDelay() en plus).
local function invokeUpgradeGeneratorWithTimeout(id, timeoutSeconds)
	local done = false
	local ok, result

	task.spawn(function()
		ok, result = pcall(function()
			return UpgradeGenerator:InvokeServer(id)
		end)
		done = true
	end)

	local startedAt = os.clock()
	local waited = 0

	while not done and waited < timeoutSeconds do
		task.wait(0.05)
		waited = waited + 0.05
	end

	local elapsedMs = math.floor((os.clock() - startedAt) * 1000 + 0.5)

	if not done then
		return false, "timeout after " .. tostring(timeoutSeconds) .. "s", elapsedMs
	end

	return ok, result, elapsedMs
end

local function upgradeFeederOnce(feederId)
	if not UpgradeGenerator
		or not UpgradeGenerator.Parent
		or not UpgradeGenerator:IsA("RemoteFunction") then

		return false, "UpgradeGenerator RemoteFunction unavailable", 0
	end

	local id = math.clamp(
		math.floor(
			tonumber(feederId)
				or AUTO_UPGRADE_FEEDER_MIN_ID
		),
		AUTO_UPGRADE_FEEDER_MIN_ID,
		AUTO_UPGRADE_FEEDER_MAX_ID
	)

	local success, result, elapsedMs =
		invokeUpgradeGeneratorWithTimeout(id, UPGRADE_FEEDER_REMOTE_TIMEOUT)

	if not success then
		return false, result, elapsedMs
	end

	return true, result, elapsedMs
end

local function startAutoBuyFeederWorker()
	invalidateAutoBuyFeederWorker()
	local token = autoBuyFeederWorkerToken

	if not autoBuyFeederEnabled then
		return
	end

	task.spawn(function()
		while autoBuyFeederEnabled
			and token == autoBuyFeederWorkerToken
			and scriptAlive() do

			local snap = CoopSnapshot.get()

			if not snap then
				setParagraph(upgradeFeederStatus, "Upgrade Feeder Status",
					"Coop data not ready...")
				task.wait(1)
			else
				local money = snap.money
				local acted, maxed, poor = 0, 0, 0

				for _, gen in ipairs(snap.generators) do
					if not autoBuyFeederEnabled
						or token ~= autoBuyFeederWorkerToken
						or not scriptAlive() then
						break
					end

					if gen.level >= snap.maxLevel then
						maxed = maxed + 1
					else
						local cost = snap.upgradeCost(gen.level)

						if not canAfford(cost, money) then
							poor = poor + 1
						else
							local ok, feederResult =
								upgradeFeederOnce(gen.slot)
							acted = acted + 1
							-- Re-lit les Coins pour ne pas surdépenser
							-- dans une même passe.
							money = getMoneyNumber()

							if not ok then
								setParagraph(upgradeFeederStatus,
									"Upgrade Feeder Status",
									"slot " .. tostring(gen.slot)
										.. " · " .. tostring(feederResult))
							end

							if autoBuyFeederEnabled
								and token == autoBuyFeederWorkerToken
								and scriptAlive() then
								task.wait(getAutoUpgradeFeederDelay())
							end
						end
					end
				end

				if acted > 0 then
					setParagraph(upgradeFeederStatus, "Upgrade Feeder Status",
						"Upgraded " .. tostring(acted) .. " feeder(s) this pass")
				else
					local total = #snap.generators

					if total == 0 then
						setParagraph(upgradeFeederStatus, "Upgrade Feeder Status",
							"No feeders yet")
					elseif maxed >= total then
						setParagraph(upgradeFeederStatus, "Upgrade Feeder Status",
							"All " .. tostring(total) .. " feeders maxed (Lv "
								.. tostring(snap.maxLevel) .. ")")
					else
						setParagraph(upgradeFeederStatus, "Upgrade Feeder Status",
							"Waiting for Coins · " .. tostring(poor)
								.. " feeder(s) pending")
					end

					-- Rien à faire : on dort, AUCUN remote tiré.
					task.wait(AUTO_COOP_IDLE_DELAY)
				end
			end
		end
	end)
end

