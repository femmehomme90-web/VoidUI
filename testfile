	end

	task.spawn(function()
		while autoArenaFightEnabled
			and token == autoArenaFightWorkerToken
			and scriptAlive() do

			local support = getArenaSupport()

			if not support then
				arenaStatus:Set({
					Title = "Arena Status",
					Content = "Arena scripts not found yet...",
				})

				task.wait(2)
			else
				local client = support.Client
				local state = support.State

				ensureArenaView(client, state)

				-- Nettoie un résultat resté affiché pour ne pas
				-- bloquer le prochain cycle de combat.
				if state.result() ~= nil then
					state.result(nil)
				end

				if state.battling() then
					arenaStatus:Set({
						Title = "Arena Status",
						Content = "Battling...",
					})

					task.wait(AUTO_ARENA_POLL_DELAY)
				else
					-- Timeout dédié à la requête de combat elle-même
					-- (matchmaking / ArenaFight), séparé du timeout de
					-- la boucle d'attente plus bas qui couvre le combat
					-- en cours une fois qu'il a réellement démarré. Sans
					-- ça, un serveur muet bloquait cette coroutine pour
					-- toujours sur "Fight sent · waiting for battle".
					local ok, fightResult =
						invokeArenaWithTimeout(client.fight, AUTO_ARENA_REMOTE_TIMEOUT)

					if ok
						and type(fightResult) == "table"
						and fightResult.ok then

						arenaStatus:Set({
							Title = "Arena Status",
							Content = "Fight sent · waiting for battle to start",
						})

						local function stillRunning()
							return autoArenaFightEnabled
								and token == autoArenaFightWorkerToken
								and scriptAlive()
						end

						-- Réagit dès qu'ArenaState.battling passe à true
						-- (abonnement Charm, pas de polling) au lieu
						-- d'attendre un délai fixe avant de vérifier.
						local started = waitForArenaCondition(
							support.Charm,
							state.battling,
							function(value)
								return value == true
							end,
							AUTO_ARENA_BATTLE_START_TIMEOUT,
							stillRunning
						)

						if started then
							arenaStatus:Set({
								Title = "Arena Status",
								Content = "Battling...",
							})

							local finished = waitForArenaCondition(
								support.Charm,
								state.battling,
								function(value)
									return value == false
								end,
								AUTO_ARENA_BATTLE_TIMEOUT,
								stillRunning
							)

							if finished then
								arenaStatus:Set({
									Title = "Arena Status",
									Content = "Battle finished · cooling down",
								})

								-- Laisse vraiment le temps au jeu de
								-- terminer la transition (sortie de la
								-- zone Arena) avant de relancer un
								-- combat. Sans cette marge, les combats
								-- peuvent s'enchaîner trop vite et
								-- finir par bloquer le joueur dans la
								-- zone Arena, sans retour possible.
								task.wait(autoArenaPostBattleDelay)
							else
								-- Timeout : on ne sait pas si le combat
								-- est vraiment terminé, donc on ne
								-- relance surtout pas un ArenaFight par
								-- dessus. Le prochain tour de boucle
								-- constatera l'état réel via
								-- state.battling().
								arenaStatus:Set({
									Title = "Arena Status",
									Content = "Still battling after timeout · waiting",
								})

								task.wait(AUTO_ARENA_POLL_DELAY)
							end
						else
							arenaStatus:Set({
								Title = "Arena Status",
								Content = "Fight sent but battle never started · cooling down",
							})

							-- Même cooldown que pour une fin de combat
							-- normale, pas un délai fixe court : un
							-- fight() qui "réussit" côté client sans
							-- jamais faire passer battling à true sent
							-- surtout un serveur pas encore prêt (match
							-- précédent pas fini de nettoyer) — retenter
							-- vite ne fait qu'aggraver ça.
							task.wait(autoArenaPostBattleDelay)
						end
					else
						local errorText = "unknown"

						if type(fightResult) == "table"
							and fightResult.error ~= nil then

							errorText = tostring(fightResult.error)
						elseif not ok then
							errorText = tostring(fightResult)
						end

						arenaStatus:Set({
							Title = "Arena Status",
							Content = "Fight failed: " .. errorText .. " · cooling down",
						})

						-- Rafraîchit tout de suite : la cause (pas
						-- d'équipe, pas d'adversaire, cooldown,
						-- timeout serveur...) peut se résoudre
						-- d'elle-même juste après.
						invokeArenaWithTimeout(client.refresh, AUTO_ARENA_REMOTE_TIMEOUT)

						-- Même cooldown qu'après un combat terminé,
						-- PAS un délai fixe court : un fight() qui
						-- time out (cause la plus fréquente ici) veut
						-- très probablement dire que le serveur n'a
						-- pas fini de nous sortir de la zone Arena du
						-- combat précédent. Retenter en 0.5s fixe (au
						-- lieu de respecter le slider) — quel que soit
						-- le réglage — c'est exactement ce qui pouvait
						-- coincer le joueur dans la zone Arena.
						task.wait(autoArenaPostBattleDelay)
					end
				end
			end
		end
	end)
end

