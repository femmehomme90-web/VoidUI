-- :Set d'un Paragraph RayVoid ne fait que réécrire deux .Text, mais quand
-- c'est appelé 10-20x/s dans une boucle chaude (statuts AutoFarm, statut
-- upgrade feeder) ça force un reflow du TabPage à chaque frame — une des
-- causes des micro-freezes signalés pendant l'AutoFarm. On ne pousse le
-- :Set que si le texte change réellement.
local function setParagraph(obj, title, content)
	if not obj then return end
	if obj._pgTitle == title and obj._pgContent == content then return end
	obj._pgTitle, obj._pgContent = title, content
	obj:Set({ Title = title, Content = content })
end

-- Cache de require() paresseux pour les modules du jeu partagés entre
-- plusieurs contrôleurs (coop, oeufs, events). Même esprit que les
-- safeRequire par contrôleur ailleurs dans ce fichier, mais mutualisé
-- pour éviter 3 copies du même require.
local GameModules = (function()
	local cache = {}

	local function safeRequire(inst)
		if not inst or not inst:IsA("ModuleScript") then return nil end
		local ok, result = pcall(require, inst)
		if not ok then return nil end
		return result
	end

	local function findModule(path)
		local cur = game
		for seg in string.gmatch(path, "[^%.]+") do
			cur = cur:FindFirstChild(seg)
			if not cur then return nil end
		end
		return cur
	end

	return {
		get = function(key, path)
			local hit = cache[key]
			if hit ~= nil then
				return hit or nil
			end
			local mod = safeRequire(findModule(path))
			cache[key] = mod or false
			return mod
		end,
	}
end)()

local dataControllerCache = nil
local function getDataController()
	if dataControllerCache ~= nil then
		return dataControllerCache or nil
	end
	local playerScripts = player:FindFirstChild("PlayerScripts")
	local core = playerScripts and playerScripts:FindFirstChild("Core")
	local data = core and core:FindFirstChild("Data")
	local moduleScript = data and data:FindFirstChild("DataController")
	local mod = nil
	if moduleScript and moduleScript:IsA("ModuleScript") then
		local ok, result = pcall(require, moduleScript)
		if ok then mod = result end
	end
	dataControllerCache = mod or false
	return mod
end

-- money() renvoie un BigNum-like ({toNumber=...}) — le comparer directement
-- à un coût numérique planterait. Renvoie toujours un number (0 si indispo).
local function getMoneyNumber()
	local dc = getDataController()
	if type(dc) ~= "table" or type(dc.money) ~= "function" then return 0 end
	local ok, m = pcall(dc.money)
	if not ok then return 0 end
	if type(m) == "table" and type(m.toNumber) == "function" then
		local ok2, n = pcall(m.toNumber, m)
		return ok2 and tonumber(n) or 0
	end
	return tonumber(m) or 0
end

-- true si on peut se payer `cost` avec `money` (number). `cost` peut être un
-- number OU un BigNum-like ({toNumber}) selon le Curve du jeu à haut niveau ;
-- si on ne sait pas trancher on renvoie true (on ne bloque pas l'action).
local function canAfford(cost, money)
	if type(cost) == "number" then
		return money >= cost
	end
	if type(cost) == "table" and type(cost.toNumber) == "function" then
		local ok, n = pcall(cost.toNumber, cost)
		if ok and type(n) == "number" then
			return money >= n
		end
	end
	return true
end

