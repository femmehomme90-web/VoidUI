-- ════════════════════════════════════════════════════════════════════════════
--  OVERLAY D'INFOS (HUD)
-- ════════════════════════════════════════════════════════════════════════════
local overlay = VoidUI:CreateOverlay({
    Position = UDim2.new(0, 20, 0, 120),
    Width    = 180,
    Items = {
        { Type = "text", Text = "VoidUI HUD", Id = "title", Bold = true, Color = Color3.fromRGB(220, 80, 160) },
        { Type = "separator" },
        { Type = "text", Text = "FPS : --",   Id = "fps"  },
        { Type = "text", Text = "Ping : --",  Id = "ping" },
        { Type = "text", Text = "Time : --",  Id = "time" },
    },
})

-- Mise à jour temps réel du HUD
task.spawn(function()
    local RunService = game:GetService("RunService")
    local Stats      = game:GetService("Stats")
    local lastTick   = tick()
    local frames     = 0
    local fps        = 0
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local now = tick()
        if now - lastTick >= 1 then
            fps      = frames
            frames   = 0
            lastTick = now
        end
    end)
    while task.wait(0.5) do
        overlay:SetText("fps", "FPS : " .. fps)
        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        overlay:SetText("ping", "Ping : " .. ping .. " ms")
        overlay:SetText("time", "Time : " .. os.date("%H:%M:%S"))
    end
end)

