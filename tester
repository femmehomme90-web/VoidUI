INSTRUCTIONS :
  1. Héberge voidUI_v3_responsive.lua sur un host raw (GitHub Gist, pastebin
     raw, raw.githubusercontent.com, etc.)
  2. Remplace l'URL ci-dessous par ton URL raw
  3. Exécute ce script dans ton executor

  Pour tester en local sur PC, tu peux aussi remplacer le loadstring par :
     local VoidUI = loadfile("voidUI_v3_responsive.lua")()
]]

-- ════════════════════════════════════════════════════════════════════════════
--  CHARGEMENT DE LA LIB
-- ════════════════════════════════════════════════════════════════════════════
local URL = "https://raw.githubusercontent.com/femmehomme90-web/VoidUI/refs/heads/main/VoidUiUPD"

local VoidUI = loadstring(game:HttpGet(URL))()

-- Nettoyage de toute UI précédente (utile en re-injectant)
VoidUI:DestroyAll()
VoidUI:SetScriptName("VoidUI_Test")

-- ════════════════════════════════════════════════════════════════════════════
--  NOTIFICATION DE BIENVENUE
-- ════════════════════════════════════════════════════════════════════════════
VoidUI:Notify({
    Title    = "VoidUI Test",
    Message  = "Script de test chargé. Ouvre les onglets pour explorer.",
    Type     = "success",
    Duration = 4,
})

-- ════════════════════════════════════════════════════════════════════════════
--  FENÊTRE PRINCIPALE
-- ════════════════════════════════════════════════════════════════════════════
local Win = VoidUI:CreateWindow({
    Title       = "Test Suite",
    Size        = UDim2.new(0, 580, 0, 440),
    TabPosition = "top",   -- mets "side" pour tester le mode latéral
    Icon        = "rbxassetid://7733964719",  -- icône optionnelle pour la pill
})

-- ════════════════════════════════════════════════════════════════════════════
--  ONGLET 1 : COMPOSANTS DE BASE
-- ════════════════════════════════════════════════════════════════════════════
local Main = Win:AddTab("Main")

Main:AddLabel("Section : Toggles & Sliders")

Main:AddToggle({
    Label    = "Auto Farm",
    Default  = false,
    Callback = function(v)
        VoidUI:Notify({
            Title    = "Auto Farm",
            Message  = v and "Activé" or "Désactivé",
            Type     = v and "success" or "info",
            Duration = 2,
        })
    end,
})

Main:AddToggle({
    Label    = "Auto Hatch",
    Default  = true,
    Callback = function(v) print("Auto Hatch:", v) end,
})

Main:AddSlider({
    Label    = "Walk Speed",
    Min      = 0,
    Max      = 300,
    Default  = 16,
    Suffix   = " sps",
    Callback = function(v)
        local lp = game.Players.LocalPlayer
        if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
            lp.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = v
        end
    end,
})

Main:AddSlider({
    Label    = "Jump Power",
    Min      = 0,
    Max      = 500,
    Default  = 50,
    Callback = function(v) print("Jump:", v) end,
})

Main:AddLabel("Section : Actions")

Main:AddButton({
    Label    = "Téléport au spawn",
    Callback = function()
        local lp = game.Players.LocalPlayer
        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            lp.Character.HumanoidRootPart.CFrame = CFrame.new(0, 50, 0)
        end
        VoidUI:Notify({ Title = "Teleport", Message = "Au spawn !", Type = "info", Duration = 2 })
    end,
})

Main:AddButton({
    Label    = "Bouton gradient custom",
    Colors   = { Color3.fromRGB(255, 80, 120), Color3.fromRGB(255, 180, 60) },
    Callback = function()
        VoidUI:Notify({ Title = "Boom", Message = "Bouton gradient cliqué", Type = "warning", Duration = 2 })
    end,
})

Main:AddButton({
    Label    = "Show credit",
    Callback = function() VoidUI:ShowCredit() end,
})

-- ════════════════════════════════════════════════════════════════════════════
--  ONGLET 2 : INPUTS
-- ════════════════════════════════════════════════════════════════════════════
local Inputs = Win:AddTab("Inputs")

Inputs:AddLabel("Section : Saisie de texte")

Inputs:AddTextInput({
    Label       = "Pseudo",
    Placeholder = "Ton pseudo...",
    Callback    = function(v) print("Pseudo:", v) end,
})

Inputs:AddTextInput({
    Label       = "URL Webhook",
    Placeholder = "https://discord.com/api/...",
    Callback    = function(v) print("Webhook:", v) end,
})

Inputs:AddLabel("Section : Choix")

local dd = Inputs:AddDropdown({
    Label    = "Mode farm",
    Options  = { "Safe", "Fast", "YOLO", "AFK" },
    Callback = function(v)
        VoidUI:Notify({ Title = "Mode", Message = "Sélectionné : " .. v, Type = "info", Duration = 2 })
    end,
})

Inputs:AddButton({
    Label    = "Ajouter une option au dropdown",
    Callback = function()
        dd:SetOptions({ "Safe", "Fast", "YOLO", "AFK", "Ultra (nouveau)" })
        VoidUI:Notify({ Title = "Dropdown", Message = "Option ajoutée", Type = "success", Duration = 2 })
    end,
})

Inputs:AddKeybind({
    Label    = "Toggle UI",
    Default  = Enum.KeyCode.F,
    Callback = function(k) print("Keybind appuyée :", k.Name) end,
})

Inputs:AddColorPicker({
    Label    = "Couleur d'effet",
    Default  = Color3.fromRGB(130, 80, 255),
    Callback = function(c) print("Couleur :", c) end,
})

-- ════════════════════════════════════════════════════════════════════════════
--  ONGLET 3 : AVANCÉ
-- ════════════════════════════════════════════════════════════════════════════
local Adv = Win:AddTab("Avancé")

Adv:AddLabel("Section : Progression")

local pb = Adv:AddProgressBar({
    Label  = "XP",
    Value  = 0,
    Max    = 100,
    Suffix = " / 100",
})

Adv:AddButton({
    Label    = "Simuler progression XP",
    Callback = function()
        for i = 0, 100, 5 do
            pb:SetValue(i)
            task.wait(0.05)
        end
        VoidUI:Notify({ Title = "Level up", Message = "XP au max", Type = "success", Duration = 2 })
    end,
})

Adv:AddLabel("Section : Multi-toggle")

Adv:AddMultiToggle({
    Label    = "Options de combat",
    Options  = { "Auto-attack", "Auto-dodge", "Auto-heal", "Auto-revive", "Auto-loot" },
    Callback = function(t)
        local count = 0
        for _ in pairs(t) do count = count + 1 end
        print(count, "options actives")
    end,
})

-- ════════════════════════════════════════════════════════════════════════════
